---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BlogIndexPage } from '../../../src/pages/BlogIndexPage';
import { blogIndexArticles } from '../../../src/data/blogArticles';

const description =
  'A2A・MCP・AIエージェント実装を、公式仕様と一次情報から読み解くAnother Starの専門メディアです。';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'A2A Insights',
  description,
  url: 'https://www.another-star.jp/blog/',
  publisher: { '@type': 'Organization', name: 'Another Star合同会社' },
  blogPost: blogIndexArticles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    url: article.href.startsWith('http')
      ? article.href
      : `https://www.another-star.jp${article.href}`,
    datePublished: article.publishedAt,
  })),
};
---

<BaseLayout
  title="A2A Insights｜Another Star"
  description={description}
  bare
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <BlogIndexPage manageMetadata={false} client:load />
</BaseLayout>
