---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BlogArticlePage } from '../../../src/pages/BlogArticlePage';
import { BlogPostPage } from '../../../src/pages/BlogPostPage';
import { blogArticles, getBlogArticle, getAdjacentArticles } from '../../../src/data/blogArticles';
import { getAllArticles } from '../lib/articles';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return [
    ...posts.map((post) => ({
      params: { slug: post.slug },
      props: { kind: 'observation', post },
    })),
    ...blogArticles.map((article) => ({
      params: { slug: article.slug },
      props: { kind: 'editorial', articleSlug: article.slug },
    })),
  ];
}

const { kind, post, articleSlug } = Astro.props;
const article = kind === 'editorial' ? getBlogArticle(articleSlug) : undefined;
const renderedPost = post ? await post.render() : undefined;
const Content = renderedPost?.Content;

// Markdown記事の表示情報はfrontmatterを正本にする。
const postMeta = post ? {
  shortTitle: post.data.shortTitle ?? post.data.title,
  category: post.data.category,
  readingTime: post.data.readingTime,
  heroImage: post.data.heroImage,
  heroAlt: post.data.heroAlt,
} : undefined;

// 目次は Markdown の h2 から自動生成する。本文を生HTMLで組んでいる記事は
// ここが空になり、BlogPostPage 側でサイドバーなしの1カラムに切り替わる。
const postToc = (renderedPost?.headings ?? [])
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

// 「次に読む」は手書きの指定ではなく発行順の前後を参照する。
const toLink = (a?: { href: string; category: string; shortTitle: string }) =>
  a ? { href: a.href, category: a.category, title: a.shortTitle } : undefined;
// 解説記事とMarkdown記事を1本に束ねた発行順の一覧から前後を引く。
const allArticles = await getAllArticles();
const adjacent = getAdjacentArticles(post ? post.slug : article!.slug, allArticles);

const POST_AUTHOR = '安田 直也';
const iso = (d: Date) => d.toISOString().slice(0, 10);

const jsonLd = post ? [
  {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  ...(post.data.heroImage && { image: `https://www.another-star.jp${post.data.heroImage}` }),
  inLanguage: 'ja',
  author: {
    '@type': 'Person',
    name: POST_AUTHOR,
    url: 'https://www.another-star.jp/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Another Star合同会社',
    url: 'https://www.another-star.jp/',
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  isPartOf: { '@type': 'Blog', name: 'A2A Insights' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.another-star.jp/' },
      { '@type': 'ListItem', position: 2, name: 'BLOG', item: 'https://www.another-star.jp/blog/' },
      { '@type': 'ListItem', position: 3, name: postMeta?.shortTitle ?? post.data.title, item: `https://www.another-star.jp/blog/${post.slug}/` },
    ],
  },
] : article ? [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.description,
    image: `https://www.another-star.jp${article.heroImage}`,
    datePublished: article.publishedAt,
    dateModified: article.updatedAt,
    inLanguage: 'ja',
    author: { '@type': 'Person', name: article.author ?? '齊藤 慎之介', url: 'https://www.another-star.jp/' },
    publisher: { '@type': 'Organization', name: 'Another Star合同会社' },
    mainEntityOfPage: `https://www.another-star.jp/blog/${article.slug}/`,
    isPartOf: { '@type': 'Blog', name: 'A2A Insights' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.another-star.jp/' },
      { '@type': 'ListItem', position: 2, name: 'BLOG', item: 'https://www.another-star.jp/blog/' },
      { '@type': 'ListItem', position: 3, name: article.shortTitle, item: `https://www.another-star.jp/blog/${article.slug}/` },
    ],
  },
] : undefined;
---

{article ? (
  <BaseLayout
    title={`${article.shortTitle}｜A2A Insights | Another Star`}
    description={article.description}
    ogType="article"
    pubDate={new Date(article.publishedAt)}
    updatedDate={new Date(article.updatedAt)}
    image={article.heroImage}
    bare
  >
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <BlogArticlePage slug={article.slug} prev={toLink(adjacent.prev)} next={toLink(adjacent.next)} />
  </BaseLayout>
) : post && Content ? (
  <BaseLayout
    title={`${postMeta?.shortTitle ?? post.data.title}｜A2A Insights | Another Star`}
    description={post.data.description}
    ogType="article"
    pubDate={post.data.pubDate}
    updatedDate={post.data.updatedDate}
    image={post.data.heroImage}
    bare
  >
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <BlogPostPage
      slug={post.slug}
      title={post.data.title}
      shortTitle={postMeta!.shortTitle}
      lead={post.data.description}
      category={post.data.category}
      publishedAt={iso(post.data.pubDate)}
      readingTime={post.data.readingTime}
      author={POST_AUTHOR}
      heroImage={post.data.heroImage}
      heroAlt={post.data.heroAlt}
      toc={postToc}
      prev={toLink(adjacent.prev)}
      next={toLink(adjacent.next)}
    >
      <Content />
    </BlogPostPage>
  </BaseLayout>
) : null}
