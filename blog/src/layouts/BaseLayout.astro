---
interface Props {
  title: string;
  description: string;
  ogType?: string;
  pubDate?: Date;
  updatedDate?: Date;
}

const { title, description, ogType = 'website', pubDate, updatedDate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0QHYFTBBB2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0QHYFTBBB2');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="A2A Insights | Another Star合同会社" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="A2A Insights" href="/blog/rss.xml" />
    <link rel="sitemap" href="/blog/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="brand" href="/">Another Star</a>
        <div class="nav-links">
          <a href="/product">PRODUCT</a>
          <a class="active" href="/blog/">BLOG</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <a href="/blog/">A2A Insights</a> — AIエージェント間連携（A2A）の動向を定点観測するブログ
      </p>
      <p>
        <a href="/blog/rss.xml">RSS</a> ·
        <a href="/">Another Star合同会社</a>
      </p>
    </footer>

    <style is:global>
      :root {
        --bg: #000000;
        --bg-card: #0a0a14;
        --text: #e5e7eb;
        --text-dim: #9ca3af;
        --accent: #67e8f9;
        --accent-dim: #155e75;
        --border: rgba(255, 255, 255, 0.1);
      }
      * { box-sizing: border-box; }
      html { background: var(--bg); }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.85;
        font-weight: 300;
      }
      .site-header nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 2.5rem;
        border-bottom: 1px solid var(--border);
      }
      .brand {
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.2em;
        font-weight: 300;
      }
      .nav-links { display: flex; gap: 2rem; }
      .nav-links a {
        color: var(--text-dim);
        text-decoration: none;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: color 0.2s;
      }
      .nav-links a:hover { color: #fff; }
      .nav-links a.active { color: var(--accent); }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 3rem 1.5rem 5rem;
      }
      a { color: var(--accent); }
      h1, h2, h3 { font-weight: 400; line-height: 1.4; }
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 2rem 2.5rem;
        color: var(--text-dim);
        font-size: 0.85rem;
        text-align: center;
      }
      .site-footer a { color: var(--text-dim); }
      .site-footer a:hover { color: var(--accent); }
      code {
        background: var(--bg-card);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 1em;
        font-weight: 500;
        line-height: 1.5;
      }
      pre {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
        overflow-x: auto;
      }
      blockquote {
        border-left: 3px solid var(--accent-dim);
        margin-left: 0;
        padding-left: 1.25rem;
        color: var(--text-dim);
      }
    </style>
  </body>
</html>
